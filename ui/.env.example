# Optional guest hub defaults baked into the production bundle at build time.
# Copy to .env.local for local dev; CI sets these from GitHub secrets (see .github/workflows/build.yml).
#
# Three independent vars — no cross-derive in UI code:
#   AUTH_USER / AUTH_PASS → WebDriver Basic Auth (Remote hub duo)
#   ACCESS_KEY            → Playwright ?accessKey= (single field)
VITE_HUB_AUTH_USER=
VITE_HUB_AUTH_PASS=
VITE_HUB_ACCESS_KEY=
