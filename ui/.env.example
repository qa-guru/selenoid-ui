# Optional guest hub defaults baked into the production bundle at build time.
# Copy to .env.local for local dev; CI sets these from GitHub secrets (see .github/workflows/build.yml).
#
#   AUTH_USER / AUTH_PASS → WebDriver Basic Auth (Remote hub duo); win when set
#   ACCESS_KEY            → Playwright ?accessKey=; also WD fallback when AUTH_* empty
VITE_HUB_AUTH_USER=
VITE_HUB_AUTH_PASS=
VITE_HUB_ACCESS_KEY=
